// ─── Xenocare database schema (Supabase Postgres) ────────────────────────────
// Every tenant-owned row carries centerId; the API scopes every query by it and
// row-level security in Supabase acts as a second safety net.
// Profiles share their id with Supabase Auth (auth.users.id).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  owner
  admin
  therapist
  teacher
  parent
}

enum Department {
  pediatric_ot
  special_school
  speech_language
  physiotherapy
  special_education
  behavioral
  sensory_integration
  learning_disabilities
  vision_therapy
  psychology
}

enum Facility {
  school
  clinic
}

enum Gender {
  male
  female
  other
}

enum PatientStatus {
  active
  discharged
  on_hold
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum PaymentMethod {
  upi
  cash
  card
  bank_transfer
  cheque
}

enum PaymentStatus {
  paid
  pending
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

// A customer: one therapy center / organisation, with one or more branches
model Center {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branches     Branch[]
  profiles     Profile[]
  patients     Patient[]
  appointments Appointment[]
  payments     Payment[]
  payouts      Payout[]

  @@map("centers")
}

model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  centerId    String       @map("center_id") @db.Uuid
  name        String
  // Short identifier, e.g. "SNK-01" — unique within a center
  code        String
  address     String       @default("")
  city        String       @default("")
  phone       String       @default("")
  email       String       @default("")
  facilities  Facility[]   @default([school, clinic])
  departments Department[] @default([])
  isActive    Boolean      @default(true) @map("is_active")
  createdById String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  center       Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdBy    Profile?      @relation("BranchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  profiles     Profile[]     @relation("ProfileBranch")
  patients     Patient[]
  appointments Appointment[]
  payments     Payment[]
  payouts      Payout[]

  @@unique([centerId, code])
  @@index([centerId])
  @@map("branches")
}

// ─── People ───────────────────────────────────────────────────────────────────

// App-side profile for a Supabase Auth user (same id as auth.users)
model Profile {
  id          String       @id @db.Uuid
  centerId    String       @map("center_id") @db.Uuid
  // Required for admin, therapist, teacher and parent; null for the owner
  branchId    String?      @map("branch_id") @db.Uuid
  name        String
  email       String       @unique
  phone       String       @default("")
  role        Role
  // Departments a therapist / teacher works in
  departments Department[] @default([])
  // Pay per completed session (₹) — drives monthly payroll
  sessionRate Decimal      @default(650) @map("session_rate") @db.Decimal(10, 2)
  isActive    Boolean      @default(true) @map("is_active")
  createdById String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  center    Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation("ProfileBranch", fields: [branchId], references: [id], onDelete: SetNull)
  createdBy Profile?  @relation("ProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created   Profile[] @relation("ProfileCreatedBy")

  // Parent → their children
  children           Patient[]          @relation("PatientParent")
  // Therapist → children assigned to them
  assignedPatients   PatientTherapist[]
  appointments       Appointment[]      @relation("AppointmentTherapist")
  scheduled          Appointment[]      @relation("AppointmentScheduledBy")
  registeredPatients Patient[]          @relation("PatientRegisteredBy")
  createdBranches    Branch[]           @relation("BranchCreatedBy")
  recordedPayments   Payment[]          @relation("PaymentRecordedBy")
  payouts            Payout[]           @relation("PayoutStaff")
  recordedPayouts    Payout[]           @relation("PayoutRecordedBy")

  @@index([centerId, role])
  @@index([branchId])
  @@map("profiles")
}

// A child receiving therapy and/or attending the special school
model Patient {
  id          String     @id @default(uuid()) @db.Uuid
  centerId    String     @map("center_id") @db.Uuid
  branchId    String     @map("branch_id") @db.Uuid
  // Human-readable ID, e.g. "SNK01-STU-0001" — unique within a branch
  studentId   String?    @map("student_id")
  name        String
  dateOfBirth DateTime   @map("date_of_birth") @db.Date
  gender      Gender
  categories  Facility[] @default([clinic])

  // School details (when categories includes school)
  grade        String @default("")
  section      String @default("")
  rollNo       String @default("") @map("roll_no")
  academicYear String @default("") @map("academic_year")

  // Parent contact details (independent of whether a parent login exists)
  parentName         String  @default("") @map("parent_name")
  parentPhone        String  @default("") @map("parent_phone")
  parentEmail        String  @default("") @map("parent_email")
  parentRelationship String  @default("Parent") @map("parent_relationship")
  parentAddress      String  @default("") @map("parent_address")
  // Linked parent login, if any
  parentId           String? @map("parent_id") @db.Uuid

  enrolledDepartments Department[]  @default([]) @map("enrolled_departments")
  medicalNotes        String        @default("") @map("medical_notes")
  diagnosis           String        @default("")
  status              PatientStatus @default(active)
  registeredById      String?       @map("registered_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  center             Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent             Profile?           @relation("PatientParent", fields: [parentId], references: [id], onDelete: SetNull)
  registeredBy       Profile?           @relation("PatientRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  assignedTherapists PatientTherapist[]
  appointments       Appointment[]
  payments           Payment[]

  @@unique([branchId, studentId])
  @@index([centerId, branchId, status])
  @@index([parentId])
  @@map("patients")
}

model PatientTherapist {
  patientId   String   @map("patient_id") @db.Uuid
  therapistId String   @map("therapist_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist Profile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@id([patientId, therapistId])
  @@index([therapistId])
  @@map("patient_therapists")
}

// ─── Sessions ─────────────────────────────────────────────────────────────────

// One 45-minute therapy session. Double booking is blocked by partial unique
// indexes on scheduled sessions, added in the migration SQL.
model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  centerId    String            @map("center_id") @db.Uuid
  branchId    String            @map("branch_id") @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  therapistId String            @map("therapist_id") @db.Uuid
  department  Department
  date        DateTime          @db.Date
  // e.g. "10:30 - 11:15" — validated against TIME_SLOTS in the API
  timeSlot    String            @map("time_slot")
  status      AppointmentStatus @default(scheduled)

  // Clinical SOAP notes
  soapSubjective String    @default("") @map("soap_subjective")
  soapObjective  String    @default("") @map("soap_objective")
  soapAssessment String    @default("") @map("soap_assessment")
  soapPlan       String    @default("") @map("soap_plan")
  // Home recommendations for parents
  homeActivities String    @default("") @map("home_activities")
  // [{ goal, status }] — replaced by goal records in Phase 1
  milestones     Json      @default("[]")
  sessionNotes   String    @default("") @map("session_notes")
  parentVisible  Boolean   @default(false) @map("parent_visible")
  notesUpdatedAt DateTime? @map("notes_updated_at") @db.Timestamptz

  scheduledById String?  @map("scheduled_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  center      Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist   Profile  @relation("AppointmentTherapist", fields: [therapistId], references: [id], onDelete: Restrict)
  scheduledBy Profile? @relation("AppointmentScheduledBy", fields: [scheduledById], references: [id], onDelete: SetNull)

  @@index([centerId, branchId, date])
  @@index([therapistId, date])
  @@index([patientId, date])
  @@map("appointments")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

// Fee invoice (pending) or receipt (paid) raised against a child
model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  centerId     String        @map("center_id") @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  receiptNo    String        @map("receipt_no")
  patientId    String        @map("patient_id") @db.Uuid
  department   Department?
  description  String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(upi)
  status       PaymentStatus @default(paid)
  // Date the money was received (null while pending)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz
  dueDate      DateTime?     @map("due_date") @db.Date
  reference    String        @default("")
  recordedById String?       @map("recorded_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy Profile? @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([branchId, receiptNo])
  @@index([centerId, branchId, status, createdAt])
  @@index([patientId])
  @@map("payments")
}

// Monthly pay for a therapist / teacher, based on completed sessions
model Payout {
  id             String        @id @default(uuid()) @db.Uuid
  centerId       String        @map("center_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  staffId        String        @map("staff_id") @db.Uuid
  // Pay period "YYYY-MM"
  period         String
  sessions       Int           @default(0)
  ratePerSession Decimal       @default(0) @map("rate_per_session") @db.Decimal(10, 2)
  bonus          Decimal       @default(0) @db.Decimal(10, 2)
  deductions     Decimal       @default(0) @db.Decimal(10, 2)
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(bank_transfer)
  reference      String        @default("")
  paidAt         DateTime      @default(now()) @map("paid_at") @db.Timestamptz
  recordedById   String?       @map("recorded_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff      Profile  @relation("PayoutStaff", fields: [staffId], references: [id], onDelete: Restrict)
  recordedBy Profile? @relation("PayoutRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  // One payout per staff member per month
  @@unique([staffId, period])
  @@index([centerId, branchId, period])
  @@map("payouts")
}
